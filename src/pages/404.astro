---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="nf surface-navy">
    <div class="container nf-inner">
      <span class="eyebrow">404</span>
      <h1>That page doesn&rsquo;t exist.</h1>
      <p class="lede">
        The link may be out of date, or the page may have moved. These are the places worth
        starting from.
      </p>
      <div class="flex-row nf-actions">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/programmes/" class="btn btn-outline-light">Programmes</a>
        <a href="/insights/" class="btn btn-outline-light">Insights</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem); }
  .nf-inner { max-width: 44rem; }
  .nf h1 { margin-bottom: 1.25rem; }
  .nf .lede { margin-bottom: 2rem; }
</style>
