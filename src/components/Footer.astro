---
import { site, footerNav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img
          src="/assets/inclusionedge-logo-horizontal-white-teal.svg"
          alt={site.name}
          width="1880"
          height="238"
          loading="lazy"
        />
        <p>{site.tagline}</p>
        <p class="footer-desc">
          Behaviour-first inclusion capability for intergenerational, neurodivergent-ready
          workforces.
        </p>
      </div>

      <div class="footer-col">
        <h2>Practice</h2>
        <ul>
          {footerNav.practice.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h2>Proof</h2>
        <ul>
          {footerNav.proof.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h2>Connect</h2>
        <ul>
          <li><a href="/contact/">Start a conversation</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>{site.locality}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--gray-400);
    padding-block: clamp(3.5rem, 6vw, 5rem) 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .footer-brand img { height: 22px; width: auto; margin-bottom: 1.4rem; }

  .footer-brand p {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--white);
    margin-bottom: 0.6rem;
    max-width: 24ch;
  }

  .footer-desc {
    font-family: var(--font-body) !important;
    font-weight: 400 !important;
    font-size: 0.875rem !important;
    color: var(--gray-400) !important;
    max-width: 32ch !important;
    line-height: 1.6;
  }

  .footer-col h2 {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 1.15rem;
  }

  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: 0.75rem; }

  .footer-col a {
    color: var(--gray-400);
    font-size: 0.9rem;
  }
  .footer-col a:hover { color: var(--teal); text-decoration: none; }

  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.75rem;
    font-size: 0.8rem;
    color: var(--gray-600);
  }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
